# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- V2 frontend (this repo) vs V1 coexistence ----
# v1 frontend dev :3000 (iiot-oee/apps/frontend, served via nginx :80 in docker)
# v2 frontend dev :3002 (this repo, `pnpm dev`), preview :3002
# backend daemon :3001 (docker-internal only, NOT exposed to host)
# nginx gateway :80 (LAN full access) + 127.0.0.1:8080 (read-only tunnel check)
#
# Recommended dev (docker stack up, zero CORS changes):
#   VITE_API_BASE_URL=""  -> same-origin /api/* via vite server.proxy
#   VITE_WS_TELEMETRY_URL="" -> same-origin /ws/telemetry via vite proxy (ws:true)
#   Proxy target defaults to http://localhost (nginx gateway).
#   Direct-daemon dev (backend via `pnpm dev` on host, no docker):
#   BACKEND_PROXY_TARGET=http://localhost:3001 pnpm dev
#
# Production LAN build behind nginx gateway:
#   VITE_API_BASE_URL="http://localhost"
#   VITE_WS_TELEMETRY_URL="ws://localhost/ws/telemetry"
#   NOTE: with absolute URLs the browser origin http://localhost:3002 is
#   cross-origin vs :80, so add it to the backend stack CORS_ORIGIN in
#   iiot-oee (e.g. CORS_ORIGIN=...,http://localhost:3002). Not needed when
#   using relative "" + proxy in dev.
VITE_API_BASE_URL=""
VITE_WS_TELEMETRY_URL=""

# VITE_API_TOKEN: optional static Bearer token for read-only surfaces (TV Andon).
# Operator-authenticated surfaces should login via POST /api/v1/auth/operator-pin
# (token is then kept in localStorage key 'oee_api_token').
VITE_API_TOKEN=""

# VITE_USE_BACKEND: switch data source between simulation (default) and real backend.
# false = simulation lane (InMemoryMachineRepository + MqttEdgeSimulatorAdapter)
# true  = backend lane   (OeeHttpLiveStateRepository + TelemetryWsClient + REST mutations)
VITE_USE_BACKEND="false"
