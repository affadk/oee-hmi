# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---- V2 frontend (this repo) — LOCAL deployment (directive 2026-11-20) ----
# v1 frontend (iiot-oee/apps/frontend) served via nginx LAN vhost; v2 dev :3002.
# docker stack: host 8080 -> container 80 (LAN read-write, HMI target);
#               127.0.0.1:8081 -> container 8080 (tunnel vhost, NOT HMI target).
# backend daemon :3001 (docker-internal only, NOT exposed to host).
#
# Recommended dev (docker stack up, zero CORS changes):
#   VITE_API_BASE_URL=""  -> same-origin /api/* via vite server.proxy
#   VITE_WS_TELEMETRY_URL="" -> same-origin /ws/telemetry via vite proxy (ws:true)
#   Proxy target defaults to http://localhost:8080 (LAN vhost).
#   Direct-daemon dev (backend via `pnpm dev` on host, no docker):
#   BACKEND_PROXY_TARGET=http://localhost:3001 pnpm dev
#
# Production LAN build (local address only):
#   VITE_API_BASE_URL="http://localhost:8080"
#   VITE_WS_TELEMETRY_URL="ws://localhost:8080/ws/telemetry"
#   NOTE: absolute URLs make browser origin cross-origin vs :8080 — add it to
#   backend CORS_ORIGIN if used. Not needed with relative "" + proxy in dev.
VITE_API_BASE_URL=""
VITE_WS_TELEMETRY_URL=""

# VITE_STATION_ID: kiosk binding — deviceId terdaftar tempat tablet ini terpasang
# (spec 044 station context). Override: localStorage store; commissioning: ?station=.
# Kosong = HMI mode station/andon (tanpa lock device).
VITE_STATION_ID=""

# VITE_API_TOKEN: optional static Bearer token for read-only surfaces (TV Andon).
# Operator-authenticated surfaces login via POST /api/v1/auth/login (password;
# PIN dihapus backend). Token kept in localStorage key 'oee_api_token'.
VITE_API_TOKEN=""

# VITE_USE_BACKEND: switch data source between simulation and real backend.
# true  = backend lane   (OeeHttpLiveStateRepository + TelemetryWsClient + REST mutations)
# false = simulation lane (InMemoryMachineRepository + MqttEdgeSimulatorAdapter, hanya untuk demo offline)
VITE_USE_BACKEND="true"
